{
  "name": "PySeguranca Dev Container",
  "image": "pyseguranca-docker:latest",
  "runArgs": [
    "-e", "DISPLAY=host.docker.internal:0",
    "--add-host=host.docker.internal:host-gateway"
  ],
  "containerEnv": {
    "DATABASE_URL": "postgres://admseguranca:admseguranca@host.docker.internal:5432/dbseguranca",
    "AMQP_ADDR": "amqp://admseguranca:admseguranca@host.docker.internal:5672/%2f"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteUser": "root",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt"
}